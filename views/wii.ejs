<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('partials/head', { 
      metaDescription: 'Send letters to a Wii Message Board: add PictoCard to your Wii address book with a one-time friend request over WiiConnect24.', 
      ogTitle: 'PictoCard - Add PictoCard to your Wii', 
      ogDescription: 'Add PictoCard to your Wii address book', 
      ogUrl: domain + '/wii', 
      canonicalUrl: domain + '/wii'
    }) %>
  </head>
  <body>
    <%- include('partials/header') %>

    <main class="container container-narrow">
      <section class="hero">
        <h1>Add PictoCard to your Wii</h1>
        <p class="hero-sub">
          To receive PictoCards on your Wii Message Board, your Wii and PictoCard need to be
          friends first. You only have to do this once.
        </p>
      </section>

      <% if (pictocardWii) { %>
      <aside class="wiilink-notice">
        <h3>PictoCard's Wii Number</h3>
        <p><code style="font-size: 1.4rem; letter-spacing: 0.05em"><%= pictocardWii %></code></p>
        <p>
          On your Wii, open the Message Board, then
          <strong>Address Book</strong>, and add this number as a friend. Or enter your own Wii
          Number below and we'll send the friend request to your Wii for you.
        </p>
      </aside>
      <% } %>

      <aside class="wiilink-notice">
        <h3>Send PictoCards from your Wii</h3>
        <p>
          <a href="/wii-app">PictoCard for Wii</a> is a free Homebrew Channel app for sending cards by
          email or to a Wii Message Board, using photos from your SD card and Miis from your Wii.
        </p>
      </aside>

      <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
      <% } %> <% if (message) { %>
      <div class="alert alert-success"><%= message %></div>
      <% } %> <% if (enabled) { %>
      <form action="/wii" method="POST" class="card-form verify-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <div class="field">
          <label for="friendCode">Your Wii Number</label>
          <input
            type="text"
            id="friendCode"
            name="friendCode"
            inputmode="numeric"
            maxlength="19"
            placeholder="1234 5678 9012 3456"
            required
          />
        </div>

        <% if (turnstileSiteKey) { %>
        <div class="cf-turnstile" data-sitekey="<%= turnstileSiteKey %>" data-theme="dark"></div>
        <% } %>

        <div class="form-actions">
          <button type="submit" class="btn btn-primary">Send Me a Friend Request</button>
          <a href="/" class="btn btn-secondary">Back</a>
        </div>
      </form>
      <% } %>
    </main>

    <%- include('partials/footer') %> <% if (turnstileSiteKey) { %>
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    <% } %>
  </body>
</html>
