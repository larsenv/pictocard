<div id="wiiLetterPreview" class="wii-letter-preview" hidden>
  <div class="wii-preview-stage">
    <img id="liveLetterhead" alt="Wii letter preview" />
    <button type="button" id="wiiAttachmentTarget" class="wii-attachment-target"
      aria-label="View attachment" hidden></button>
    <button type="button" id="wiiExpanded" class="wii-expanded-preview" aria-label="Back to letter" hidden>
      <img id="wiiExpandedImage" alt="Wii attachment" />
    </button>
  </div>
  <div class="wii-preview-controls">
    <button type="button" class="btn btn-secondary" id="wiiPrevious" aria-label="Previous message page">↑</button>
    <span id="wiiPage" class="field-hint" aria-live="polite"></span>
    <button type="button" class="btn btn-secondary" id="wiiNext" aria-label="Next message page">↓</button>
  </div>
  <p id="liveLetterText" class="sr-only"></p>
</div>
<% if (typeof wiiPreviewData !== 'undefined' && wiiPreviewData) { %>
<script type="application/json" id="wiiPreviewData"><%- JSON.stringify(wiiPreviewData).replace(/</g, '\\u003c') %></script>
<% } %>
