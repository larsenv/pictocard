<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title><%- (typeof ogTitle !== 'undefined' && ogTitle) ? ogTitle : 'PictoCard - send customizable greeting cards by email or Discord' %></title>
<meta name="description" content="<%- (typeof metaDescription !== 'undefined' && metaDescription) ? metaDescription : 'PictoCard - send customizable greeting cards by email or Discord.' %>" />
<meta name="keywords" content="PictoCard, greeting cards, digital cards, e-cards, email cards, Discord cards, Wii Message Board, send message to Wii, WiiConnect24, Wii letter, personalized photo cards, iCards alternative, free greeting card maker" />
<meta name="theme-color" content="#31bdf6" />
<meta name="author" content="PictoCard" />
<meta name="application-name" content="PictoCard" />
<% if (typeof metaRobots !== 'undefined' && metaRobots) { %>
<meta name="robots" content="<%- metaRobots %>" />
<% } %>
<% if (typeof canonicalUrl !== 'undefined' && canonicalUrl) { %>
<link rel="canonical" href="<%- canonicalUrl %>" />
<% } %>

<!-- Open Graph -->
<meta property="og:title" content="<%- (typeof ogTitle !== 'undefined' && ogTitle) ? ogTitle : 'PictoCard' %>" />
<meta property="og:description" content="<%- (typeof ogDescription !== 'undefined' && ogDescription) ? ogDescription : 'Send customizable greeting cards by email or Discord' %>" />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="PictoCard" />
<meta property="og:locale" content="en_US" />
<meta property="og:image:alt" content="PictoCard logo" />
<meta property="og:image" content="<%= domain %>/apple-touch-icon.png" />
<% if (typeof ogUrl !== 'undefined' && ogUrl) { %>
<meta property="og:url" content="<%- ogUrl %>" />
<% } %>

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content="<%- (typeof ogTitle !== 'undefined' && ogTitle) ? ogTitle : 'PictoCard' %>" />
<meta name="twitter:description" content="<%- (typeof ogDescription !== 'undefined' && ogDescription) ? ogDescription : 'Send customizable greeting cards by email or Discord' %>" />
<meta name="twitter:image" content="<%= domain %>/apple-touch-icon.png" />
<meta name="twitter:image:alt" content="PictoCard logo" />

<!-- Structured Data -->
<script type="application/ld+json">
  [
    {
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "PictoCard",
      "url": "<%= domain %>",
      "description": "Create and send customizable greeting cards by email, on Discord, or to a Nintendo Wii Message Board.",
      "applicationCategory": "MultimediaApplication",
      "operatingSystem": "Web",
      "browserRequirements": "Requires a modern web browser",
      "featureList": ["Custom photo greeting cards", "Send by email", "Send as a Discord DM", "Send to a Wii Message Board", "Wii letterheads and Mii faces", "Custom fonts and text colors", "Opt out any time"],
      "isAccessibleForFree": true,
      "license": "https://www.gnu.org/licenses/gpl-3.0.html",
      "codeRepository": "https://github.com/larsenv/pictocard",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      }
    },
    {
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "PictoCard",
      "url": "<%= domain %>",
      "inLanguage": "en"
    },
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "PictoCard",
      "url": "<%= domain %>",
      "logo": "<%= domain %>/apple-touch-icon.png"
    }
  ]
</script>
<% if (typeof faq !== 'undefined' && faq && faq.length) { %>
<script type="application/ld+json">
  <%- JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map(function (f) {
      return { '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } };
    })
  }).replace(/</g, '\\u003c') %>
</script>
<% } %>

<script>
  try {
    const savedTheme = localStorage.getItem('pictocard-theme');
    document.documentElement.dataset.theme = savedTheme === 'light' || savedTheme === 'dark'
      ? savedTheme : matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  } catch {
    document.documentElement.dataset.theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  }
</script>
<link rel="preload" href="/css/RodinNTLGPro-DB-Extended.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/css/RodinNTLGPro-B-Extended.woff2" as="font" type="font/woff2" crossorigin />
<link rel="stylesheet" href="/css/main.css" />
<script src="/js/site.js" defer></script>
<link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="shortcut icon" href="/favicon.ico" />
