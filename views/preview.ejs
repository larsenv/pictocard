<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('partials/head', { 
      metaDescription: 'Preview Your Card', 
      ogTitle: 'PictoCard - Preview Your Card', 
      ogDescription: 'Preview Your Card', 
      ogUrl: domain + '/preview', 
      canonicalUrl: domain + '/preview', 
      metaRobots: 'noindex, nofollow' 
    }) %>
  </head>
  <body>
    <%- include('partials/header') %>

    <main class="container">
      <section class="hero">
        <h1>Preview Your Card</h1>
        <p class="hero-sub">
          <% if (wii) { %> This letter will be sent to the Wii <strong><%= wii.recipient %></strong>.
          <% } else if (recipientEmail) { %> This card will be sent to
          <strong><%= recipientEmail %></strong>. <% } else if (recipientDiscord) { %> This card
          will be sent to Discord user <strong><%= recipientDiscord %></strong>. <% } %>
        </p>
      </section>

      <% if (typeof sendError !== 'undefined' && sendError) { %>
      <div class="alert alert-error"><%= sendError %></div>
      <% } %>

      <% if (wii) { %>
      <div class="preview-wrapper">
        <article class="wii-letter">
          <% if (wii.letterhead) { %>
          <img src="<%= wii.letterhead.preview %>" alt="Letterhead: <%= wii.letterhead.name %>" class="wii-letter-head" />
          <% } else { %>
          <img src="/images/letterheads/default.png" alt="Default letterhead" class="wii-letter-head" />
          <% } %>
          <div class="wii-letter-body">
            <% if (senderName) { %><div class="wii-letter-from">From <%= senderName %></div><% } %>
            <p><%= wiiText %></p>
          </div>
          <% if (previewDataUrl) { %>
          <div class="wii-letter-attach">
            <img src="<%= previewDataUrl %>" alt="Attachment Preview" />
          </div>
          <% } %>
        </article>
        <p class="hint-text">
          <%= wii.hasMii ? 'Includes your Mii. ' : '' %><%= wii.letterhead ? 'Letterhead: ' + wii.letterhead.name + '.' : '' %>
        </p>
      </div>
      <% } else { %>
      <div class="preview-wrapper">
        <img src="<%= previewDataUrl %>" alt="Card Preview" class="card-preview-img" />
      </div>
      <% } %>

      <div class="preview-actions">
        <% if (typeof sendError !== 'undefined' && sendError && canRetryDirectly) { %>
        <form action="/verify" method="POST" style="display: inline">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <input type="hidden" name="retry" value="1" />
          <button type="submit" class="btn btn-primary btn-lg">Retry Send 🔄</button>
        </form>
        <% } else if (skipVerify) { %>
        <form action="/verify" method="POST" style="display: inline">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <input type="hidden" name="retry" value="1" />
          <button type="submit" class="btn btn-primary btn-lg">Send 🎉</button>
        </form>
        <% } else { %>
        <form action="/verify-request" method="POST" style="display: inline">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <button type="submit" class="btn btn-primary btn-lg">Verify &amp; Send 🎉</button>
        </form>
        <% } %>
        <a href="/" class="btn btn-secondary btn-lg">Edit Card</a>
      </div>
    </main>

    <%- include('partials/footer') %>
  </body>
</html>
