<!DOCTYPE html>
<html lang="en">
  <head>
    <%- include('partials/head', {
      metaDescription: 'Create and send customizable greeting cards by email, on Discord or to a Wii Message Board. Upload any photo, write your message, pick your font and color. A free and simple iCards alternative.',
      ogTitle: 'PictoCard - Send a Greeting Card',
      ogDescription: 'Create and send customizable greeting cards by email or on Discord',
      ogUrl: domain + '/',
      canonicalUrl: domain + '/',
      faq: faq
    }) %>
  </head>
  <body>
    <%- include('partials/header') %>

    <main class="container composer">
      <% if (success) { %>
      <div class="alert alert-success">🎉 Your card was sent successfully!</div>
      <% } %> <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
      <% } %>

      <section class="hero">
        <h1>Send a PictoCard!</h1>
        <p class="hero-sub">Create a personalized greeting card and send it by email or on Discord. Or send a special note to a Wii Message Board with WiiLink!</p>
        <p class="hero-badge"><a href="/wii-app">Send PictoCards from your Wii with PictoCard for Wii &rarr;</a></p>
      </section>

      <div class="editor-layout">
      <form
        action="/create"
        method="POST"
        enctype="multipart/form-data"
        class="card-form"
        id="cardForm"
      >
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <% var discordTab = !!(pending && pending.verifyViaDiscord); var wiiTab = !!(pending && pending.wiiTab); %>

        <!-- ── Recipient (tab switcher) ── -->
        <section class="form-group" aria-labelledby="recipientHeading">
          <h2 class="panel-title" id="recipientHeading">
            <span class="panel-title-label"><%- include('partials/step', { number: '01' }) %>Who is it for?</span>
          </h2>
          <div class="group-content">
            <div class="delivery-tabs">
              <button
                type="button"
                class="tab-btn <%= (discordTab || wiiTab) ? '' : 'tab-active' %>"
                id="tabEmail"
                data-tab="email"
              >
                Email
              </button>
              <button
                type="button"
                class="tab-btn <%= discordTab ? 'tab-active' : '' %>"
                id="tabDiscord"
                data-discord-auth="<%= (discordOAuthEnabled && !discordUser) ? '0' : '1' %>"
              >
                Discord<% if (discordOAuthEnabled && !discordUser) { %> 🔒<% } %>
              </button>
              <button
                type="button"
                class="tab-btn <%= wiiTab ? 'tab-active' : '' %>"
                id="tabWii"
                data-tab="wii"
              >
                Wii
              </button>
            </div>

            <div
              id="panelEmail"
              class="tab-panel"
              style="<%= (discordTab || wiiTab) ? 'display:none' : '' %>"
            >
              <div class="field">
                <label for="recipientEmail">Recipient Email Address</label>
                <input
                  type="email"
                  id="recipientEmail"
                  name="recipientEmail"
                  placeholder="friend@example.com"
                  autocomplete="off"
                  value="<%= (pending && pending.recipientEmail) || '' %>"
                />
              </div>
            </div>

            <div
              id="panelDiscord"
              class="tab-panel"
              style="<%= (pending && pending.verifyViaDiscord) ? '' : 'display:none' %>"
            >
              <% if (discordOAuthEnabled) { %> <% if (discordUser) { %>
              <div class="discord-connected">
                <span class="discord-connected-label"
                  >✅ Connected as <strong><%= discordUser.displayName %></strong></span
                >
                <a href="/discord/logout" class="btn btn-sm btn-secondary">Disconnect</a>
              </div>
              <% } else { %>
              <div class="discord-login-prompt">
                <a href="/discord" class="btn btn-discord">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="18"
                    height="18"
                    viewBox="0 0 127.14 96.36"
                    style="vertical-align: middle; margin-right: 6px; fill: currentColor"
                  >
                    <path
                      d="M107.7 8.07A105.15 105.15 0 0 0 81.47 0a72.06 72.06 0 0 0-3.36 6.83 97.68 97.68 0 0 0-29.11 0A72.37 72.37 0 0 0 45.64 0a105.89 105.89 0 0 0-26.25 8.09C2.79 32.65-1.71 56.6.54 80.21a105.73 105.73 0 0 0 32.17 16.15 77.7 77.7 0 0 0 6.89-11.11 68.42 68.42 0 0 1-10.85-5.18c.91-.66 1.8-1.34 2.66-2a75.57 75.57 0 0 0 64.32 0c.87.71 1.76 1.39 2.66 2a68.68 68.68 0 0 1-10.87 5.19 77 77 0 0 0 6.89 11.1 105.25 105.25 0 0 0 32.19-16.14c2.64-27.38-4.51-51.11-18.9-72.15zM42.45 65.69C36.18 65.69 31 60 31 53s5-12.74 11.43-12.74S54 46 53.89 53s-5.05 12.69-11.44 12.69zm42.24 0C78.41 65.69 73.25 60 73.25 53s5-12.74 11.44-12.74S96.23 46 96.12 53s-5.04 12.69-11.44 12.69z"
                    />
                  </svg>
                  Log in with Discord to continue
                </a>
                <span class="field-hint">Discord login is required to send via Discord DM.</span>
              </div>
              <% } %> <% } %>
              <div class="field">
                <label for="recipientDiscord">Discord Username</label>
                <div class="username-field"><span class="username-prefix" aria-hidden="true">@</span><input
                  type="text"
                  id="recipientDiscord"
                  name="recipientDiscord"
                  placeholder="username" autocapitalize="none" spellcheck="false"
                  autocomplete="off"
                  value="<%= ((pending && pending.recipientDiscord) || '').replace(/^@+/, '') %>"
                /></div>
                <span class="field-hint"
                  >Enter the recipient's Discord username. The PictoCard bot must share a
                  server with them.
                  <a
                    href="http://discord.com/oauth2/authorize?client_id=1480701823382720582&amp;permissions=3072&amp;scope=bot"
                    target="_blank"
                    rel="noopener"
                    >Invite the bot</a
                  ></span
                >
              </div>
            </div>

            <div
              id="panelWii"
              class="tab-panel"
              style="<%= wiiTab ? '' : 'display:none' %>"
            >
              <% if (!wiiEnabled) { %>
              <p class="field-hint">Wii delivery isn't set up yet. Please check back soon.</p>
              <% } %>
              <div class="field">
                <label for="recipientWii">Recipient Wii Number</label>
                <input
                  type="text"
                  id="recipientWii"
                  name="recipientWii"
                  inputmode="numeric"
                  maxlength="19"
                  placeholder="1234 5678 9012 3456"
                  autocomplete="off"
                  value="<%= (pending && pending.recipientWii) || '' %>"
                />
                <span class="field-hint"
                  >The recipient's Wii needs WiiLink and PictoCard in its address book.
                  <a href="/wii">Add PictoCard to a Wii</a> (only needed once).</span
                >
                <button
                  type="submit"
                  class="btn btn-secondary btn-sm"
                  formaction="/wii"
                  formenctype="application/x-www-form-urlencoded"
                  formnovalidate
                  data-wii-enabled="<%= wiiEnabled ? '1' : '0' %>"
                  <%= wiiEnabled ? '' : 'disabled' %>
                >
                  Send Friend Request
                </button>
              </div>

              <div class="field">
                <label for="wiiMii">Mii Face (Optional)</label>
                <span class="field-hint">Face previews send Mii appearance data to <a href="https://mii-unsecure.ariankordi.net/" target="_blank" rel="noopener">Arian Kordi's renderer</a>.</span>
                <input type="file" id="wiiMii" name="wiiMii" />
                <div class="mii-result" id="wiiMiiResult" hidden>
                  <img id="wiiMiiThumbnail" alt="Your Mii face" width="64" height="64" />
                </div>
                <span class="field-hint"
                  >A Wii Mii file (74 bytes, or 76 with the checksum), sent as your face on the letter. <%= pending && pending.wiiMiiData ? 'Leave empty to keep your current face.' : '' %></span
                >
              </div>

              <div class="field">
                <label>Attachment (Optional)</label>
                <div class="radio-row">
                  <label><input type="radio" name="wiiAttach" value="none" <%= (!pending || !pending.wiiAttach || pending.wiiAttach === 'none') ? 'checked' : '' %> /> None</label>
                  <label><input type="radio" name="wiiAttach" value="image" <%= pending && pending.wiiAttach === 'image' ? 'checked' : '' %> /> Picture</label>
                  <label><input type="radio" name="wiiAttach" value="card" <%= pending && pending.wiiAttach === 'card' ? 'checked' : '' %> /> PictoCard</label>
                </div>
                <div id="wiiImageField" style="display: none">
                  <input
                    type="file"
                    id="wiiImage"
                    name="wiiImage"
                    accept="image/jpeg,image/png,image/gif,image/webp"
                  />
                  <span class="field-hint"
                    >JPEG, PNG, GIF or WebP, up to 10 MB. <%= pending && pending.wiiImage ? 'Leave empty to keep your current picture.' : '' %></span
                  >
                  <label for="wiiImageUrl">Or import from a link</label>
                  <div class="image-url-row">
                    <input type="url" id="wiiImageUrl" inputmode="url" autocomplete="off"
                      autocapitalize="none" spellcheck="false" placeholder="https://example.com/photo.jpg" />
                    <button type="button" class="btn btn-secondary" id="importWiiImage">Import</button>
                  </div>
                  <span class="field-hint" id="wiiImageUrlStatus" role="status" aria-live="polite">Paste a direct link to a JPEG, PNG, GIF or WebP image.</span>
                  <button type="button" class="btn btn-secondary" data-doodle-target="wiiImage">Or draw a doodle</button>
                </div>
                <div id="wiiCardTextField" style="display: none">
                  <label for="wiiCardText">Text on the PictoCard (Optional)</label>
                  <textarea
                    id="wiiCardText"
                    name="wiiCardText"
                    rows="3"
                    maxlength="500"
                    placeholder="Leave empty to use your message"
                  ><%= pending && pending.wiiCardText || '' %></textarea>
                  <span class="field-hint"
                    >The card uses the Card Image and font below. Your message above is still the
                    text of the letter.</span
                  >
                </div>
              </div>

              <% if (letterheadGroups && letterheadGroups.length > 0) { %>
              <div class="field">
                <label>Letterhead</label>
                <details class="letterhead-details">
                  <summary>Choose a Letterhead</summary>
                  <h4 class="letterhead-group">Default</h4>
                  <div class="letterhead-gallery">
                    <label class="preset-option" title="Default (no letterhead)">
                      <input type="radio" name="letterhead" value="" <%= (!pending || !pending.letterhead) ? 'checked' : '' %> />
                      <img src="/images/letterheads/default.png" alt="Default letterhead" loading="lazy" />
                    </label>
                  </div>
                  <% letterheadGroups.forEach(function(g) { %>
                  <h4 class="letterhead-group"><%= g.group %></h4>
                  <div class="letterhead-gallery">
                    <% g.items.forEach(function(l) { %>
                    <label class="preset-option" title="<%= l.name %>">
                      <input type="radio" name="letterhead" value="<%= l.id %>" <%= pending && pending.letterhead === l.id ? 'checked' : '' %> />
                      <img src="<%= l.preview %>" alt="<%= l.name %>" loading="lazy" />
                    </label>
                    <% }); %>
                  </div>
                  <% }); %>
                </details>
              </div>
              <% } %>
            </div>
            <div
              class="sender-fields"
              id="senderFields"
              style="<%= (pending && pending.verifyViaDiscord) ? 'display:none' : '' %>"
            >
              <div class="field" id="senderNameField">
                <label for="senderName">Your Name</label>
                <input
                  type="text"
                  id="senderName"
                  name="senderName"
                  required
                  placeholder="Your name"
                  maxlength="80"
                  value="<%= (pending && pending.senderName) || '' %>"
                />
                <span class="field-hint" id="senderNameHint">Shown on the card and in the email.</span>
              </div>

              <div class="field" id="senderEmailField">
                <label for="senderEmail" id="senderEmailLabel">Your Email</label>
                <input
                  type="email"
                  id="senderEmail"
                  name="senderEmail"
                  required
                  placeholder="you@example.com"
                  autocomplete="off"
                  value="<%= (pending && pending.senderEmail) || '' %>"
                />
              </div>
            </div>
          </div>
        </section>

        <input
          type="hidden"
          name="deliveryMethod"
          id="deliveryMethod"
          value="<%= discordTab ? 'discord' : (wiiTab ? 'wii' : 'email') %>"
        />

        <!-- ── Image ── -->
        <section class="form-group" id="cardImageGroup" aria-labelledby="pictureHeading">
          <h2 class="panel-title" id="pictureHeading">
            <span class="panel-title-label"><%- include('partials/step', { number: '02' }) %>Your picture</span>
          </h2>
          <div class="group-content">
            <div class="field card-type-field" id="cardTypeField">
              <span class="field-label">Card style</span>
              <div class="radio-row">
                <label><input type="radio" name="cardType" value="card"
                  <%= pending && pending.cardType === 'doodle' ? '' : 'checked' %> /> PictoCard (picture and message)</label>
                <label><input type="radio" name="cardType" value="doodle"
                  <%= pending && pending.cardType === 'doodle' ? 'checked' : '' %> /> Doodle (your drawing is the card)</label>
              </div>
            </div>
            <div class="picture-upload">
              <img id="pictureThumbnail" alt="Selected picture" hidden />
              <div class="picture-upload-controls">
                <label for="cardImage" class="sr-only">Upload an Image</label>
                <input type="file" id="cardImage" name="cardImage"
                  accept="image/jpeg,image/png,image/gif,image/webp" hidden />
                <strong id="pictureFileName"><%= pending && pending.originalImage ? 'Current picture' : 'Choose a picture' %></strong>
                <p class="field-hint" data-photo-only>JPEG, PNG, GIF or WebP - max 10 MB.</p>
                <div class="picture-upload-actions">
                  <button type="button" class="btn btn-secondary" id="choosePicture" data-photo-only><%= pending && pending.originalImage ? 'Change picture' : 'Upload picture' %></button>
                  <button type="button" class="btn btn-secondary" data-doodle-target="cardImage">Draw a doodle</button>
                </div>
              </div>
            </div>

            <div class="field image-url-field" data-photo-only>
              <label for="imageUrl">Or import from a link</label>
              <div class="image-url-row">
                <input type="url" id="imageUrl" inputmode="url" autocomplete="off"
                  autocapitalize="none" spellcheck="false" placeholder="https://example.com/photo.jpg" />
                <button type="button" class="btn btn-secondary" id="importImage">Import</button>
              </div>
              <span class="field-hint" id="imageUrlStatus" role="status" aria-live="polite">Paste a direct link to a JPEG, PNG, GIF or WebP image.</span>
            </div>

            <% if (presets && presets.length > 0) { %>
            <div class="field" data-photo-only>
              <details class="preset-details">
                <summary>Or choose a preset</summary>
                <div class="preset-gallery">
                  <% presets.forEach(function(src) { %>
                  <label class="preset-option">
                    <input type="radio" name="presetImage" value="<%= src %>" />
                    <img src="<%= src %>" alt="PictoCard Preset Card Background" loading="lazy" />
                  </label>
                  <% }); %>
                </div>
              </details>
            </div>
            <% } %>
          </div>
        </section>

        <!-- ── Message ── -->
        <section class="form-group" aria-labelledby="messageHeading">
          <h2 class="panel-title" id="messageHeading">
            <span class="panel-title-label"><%- include('partials/step', { number: '03' }) %>Your message</span>
          </h2>
          <div class="group-content">
            <div class="field">
              <label for="cardText"
                ><span id="messageLabel">Message</span> <span class="char-counter" id="charCounter">0 / 500</span></label
              >
              <textarea
                id="cardText"
                name="cardText"
                rows="5"
                maxlength="500"
                placeholder="Write your message here..."
              ><%= (pending && pending.cardText) || '' %></textarea>
              <span class="field-hint" id="messageFitHint">Up to 500 characters. Card text sizes to fit; the preview shows the result.</span>
            </div>

            <div class="field-row" id="fontRow">
              <div class="field field-grow">
                <label for="fontFamily">Font</label>
                <select id="fontFamily" name="fontFamily">
                  <% fonts.forEach(function(f) { %>
                    <% if (((pending && pending.fontFamily) || 'rodinntlg') === f.family) { %>
                      <option value="<%= f.family %>" data-file="<%= f.file %>" selected><%= f.name %></option>
                    <% } else { %>
                      <option value="<%= f.family %>" data-file="<%= f.file %>"><%= f.name %></option>
                    <% } %>
                  <% }); %>
                </select>
              </div>

              <div class="field field-shrink">
                <label for="textColor">Text Color</label>
                <div class="color-picker-wrap">
                  <input type="color" id="textColor" name="textColor" value="<%= (pending && pending.textColor) || '#111111' %>" />
                  <span class="color-label" id="colorLabel"><%= (pending && pending.textColor) || '#111111' %></span>
                </div>
              </div>
            </div>

            <div class="background-field" id="cardBackgroundGroup">
              <span class="field-label">Text background</span>
              <div class="radio-row">
                <label><input type="radio" name="cardBackground" value="light"
                  <%= !pending || pending.cardBackground !== 'dark' ? 'checked' : '' %> /> Light</label>
                <label><input type="radio" name="cardBackground" value="dark"
                  <%= pending && pending.cardBackground === 'dark' ? 'checked' : '' %> /> Dark</label>
              </div>
            </div>

            <details class="mii-details" id="extrasGroup" <%= pending && pending.miiData ? 'open' : '' %>>
              <summary><span>Add a Mii</span><span class="field-hint">.mii / .ffsd / .charinfo / .mnms</span></summary>

              <div class="field">
                <span class="field-label" id="miiTabsLabel">Mii on the PictoCard</span>
                <span class="field-hint">Loading or previewing a Mii sends its data to <a href="https://mii-unsecure.ariankordi.net/" target="_blank" rel="noopener">Arian Kordi's renderer</a>. ID lookups also send the entered NNID or PNID.</span>
                <input type="hidden" id="miiSource" value="nnid" />
                <div class="delivery-tabs mii-tabs" role="tablist" aria-labelledby="miiTabsLabel">
                  <button type="button" class="tab-btn tab-active" role="tab" aria-selected="true" data-mii-tab="nnid">NNID</button>
                  <button type="button" class="tab-btn" role="tab" aria-selected="false" data-mii-tab="pnid">PNID</button>
                  <button type="button" class="tab-btn" role="tab" aria-selected="false" data-mii-tab="file">File / Data</button>
                  <button type="button" class="tab-btn" role="tab" aria-selected="false" data-mii-tab="qr">QR Code</button>
                </div>
                <div id="miiDrop" class="mii-drop">
                <div id="miiLookupField">
                  <label for="miiLookup" id="miiLookupLabel">Nintendo Network ID</label>
                  <input type="text" id="miiLookup" maxlength="16" autocomplete="off" autocapitalize="none" spellcheck="false" placeholder="e.g. JasmineChlora" />
                </div>
                <div id="miiFileField" hidden>
                  <label for="miiFile" id="miiFileLabel">Upload a Mii file</label>
                  <input type="file" id="miiFile" name="miiFile" />
                </div>
                <div id="miiCodeField" hidden>
                  <label for="miiCode">Or paste hex, Base64 or a Mii Studio URL</label>
                  <textarea id="miiCode" rows="3" maxlength="4096" placeholder="AwBgMIJUICvp…"></textarea>
                </div>
                </div>
                <div class="field mii-expression">
                  <label for="miiExpression">Expression</label>
                  <select id="miiExpression" name="miiExpression">
                    <% miiExpressionGroups.forEach(function(group) { %>
                    <optgroup label="<%= group.label %>">
                      <% group.items.forEach(function(item) { %>
                      <option value="<%= item[0] %>" <%= miiExpression === item[0] ? 'selected' : '' %>><%= item[1] %></option>
                      <% }); %>
                    </optgroup>
                    <% }); %>
                  </select>
                </div>
                <input type="hidden" id="cardMiiData" name="cardMiiData" value="<%= pending && pending.miiData || '' %>" />
                <div class="mii-actions">
                  <button type="button" class="btn btn-secondary" id="removeCardMii" <%= pending && pending.miiData ? '' : 'hidden' %>>Remove Mii</button>
                </div>
                <div class="mii-result">
                  <img id="cardMiiThumbnail" alt="Selected Mii" hidden />
                  <span id="cardMiiStatus" class="field-hint" role="status"><%= pending && pending.miiData ? 'Current Mii kept. Load another to replace it.' : 'Optional. Your Mii loads as soon as you enter or choose it.' %></span>
                </div>
                <span class="field-hint" id="miiSourceHint">Loads the Mii attached to that Nintendo account. You can also drop a file or QR image here.</span>
              </div>
            </details>
          </div>
        </section>

        <% if (turnstileSiteKey) { %>
        <div class="cf-turnstile" data-sitekey="<%= turnstileSiteKey %>" data-theme="auto"></div>
        <% } %>

        <button type="submit" class="btn btn-primary btn-lg">Review your card &rarr;</button>
        <p class="form-foot">Nothing is sent until you confirm.</p>
      </form>

      <aside class="live-preview" id="livePreview" aria-label="Card preview">
        <div class="preview-heading">
          <h2 id="previewHeading">Live preview</h2>
          <button type="button" class="mobile-preview-toggle" id="openPreview" aria-controls="livePreview" aria-expanded="false">Open</button>
          <button type="button" class="btn btn-secondary preview-close" id="closePreview">Close</button>
        </div>
        <div class="live-preview-content">
          <%- include('partials/wii-preview') %>
          <img id="liveCardImage" alt="Live card preview" hidden />
        </div>
        <p id="previewStatus" class="hint-text" role="status">Loading your preview…</p>
        <p class="field-hint" id="previewDescription">Changes appear here as you edit. Nothing is sent until you confirm.</p>
      </aside>
      </div>

      <section class="faq" aria-labelledby="faq-title">
        <h2 id="faq-title">Frequently Asked Questions</h2>
        <% faq.forEach(function(f) { %>
        <details>
          <summary><%= f.q %></summary>
          <p><%= f.a %></p>
        </details>
        <% }); %>
      </section>
    </main>

    <%- include('partials/footer') %>
    <% if (turnstileSiteKey) { %>
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    <% } %>

    <script nonce="<%= nonce %>">
      const discordName = document.getElementById('recipientDiscord');
      discordName.addEventListener('input', () => {
        discordName.value = discordName.value.replace(/^@+/, '');
      });

      // Character counter
      const ta = document.getElementById('cardText');
      const counter = document.getElementById('charCounter');
      if (ta && counter) {
        counter.textContent = `${ta.value.length} / 500`;
        ta.addEventListener('input', () => {
          counter.textContent = `${ta.value.length} / 500`;
        });
      }

      // Color picker label sync
      const colorInput = document.getElementById('textColor');
      const colorLabel = document.getElementById('colorLabel');
      if (colorInput && colorLabel) {
        colorInput.addEventListener('input', () => {
          colorLabel.textContent = colorInput.value;
        });
      }

      // Wii tab: show only the fields that apply
      function applyWiiMode() {
        const wii = document.getElementById('deliveryMethod').value === 'wii';
        const attach = (document.querySelector('input[name="wiiAttach"]:checked') || {}).value;
        const showCard = !wii || attach === 'card';
        const doodle = showCard && (document.querySelector('input[name="cardType"]:checked') || {}).value === 'doodle';
        const showStyle = showCard && !doodle;
        const backgroundGroup = document.getElementById('cardBackgroundGroup');
        backgroundGroup.style.display = showStyle ? '' : 'none';
        backgroundGroup.querySelectorAll('input').forEach((field) => { field.disabled = false; });
        const imageGroup = document.getElementById('cardImageGroup');
        const fontRow = document.getElementById('fontRow');
        if (imageGroup) imageGroup.style.display = showCard ? '' : 'none';
        if (fontRow) fontRow.style.display = showStyle ? '' : 'none';
        // The Mii File extra is the Mii drawn on a PictoCard (separate from the Mii Face)
        const extras = document.getElementById('extrasGroup');
        if (extras) extras.style.display = showStyle ? '' : 'none';
        const imgField = document.getElementById('wiiImageField');
        const cardTextField = document.getElementById('wiiCardTextField');
        if (imgField) imgField.style.display = attach === 'image' ? '' : 'none';
        if (cardTextField) cardTextField.style.display = attach === 'card' ? '' : 'none';
        for (const group of [imageGroup, extras]) {
          if (group) group.querySelectorAll('input, select, textarea').forEach((field) => {
            field.disabled = !showCard;
          });
        }
        if (extras) extras.querySelectorAll('input, select, textarea').forEach((field) => {
          field.disabled = !showStyle;
        });
        for (const el of document.querySelectorAll('[data-photo-only]')) el.hidden = doodle;
        const messageLabel = document.getElementById('messageLabel');
        if (messageLabel) messageLabel.textContent = doodle ? 'Message (optional, sent with your doodle)' : 'Message';
        const fitHint = document.getElementById('messageFitHint');
        if (fitHint) fitHint.hidden = doodle;
        const doodleButton = document.querySelector('[data-doodle-target="cardImage"]');
        if (doodleButton) {
          doodleButton.classList.toggle('btn-primary', doodle);
          doodleButton.classList.toggle('btn-secondary', !doodle);
        }
        const pictureName = document.getElementById('pictureFileName');
        if (pictureName && ['Choose a picture', 'Draw your doodle'].includes(pictureName.textContent)) {
          pictureName.textContent = doodle ? 'Draw your doodle' : 'Choose a picture';
        }
        if (imgField) imgField.querySelector('input').disabled = !wii || attach !== 'image';
        if (cardTextField) cardTextField.querySelector('textarea').disabled = !wii || attach !== 'card';
        const text = document.getElementById('cardText');
        if (text) text.required = wii;
        const wiiNum = document.getElementById('recipientWii');
        if (wiiNum) wiiNum.required = wii;
        // Wii mail needs no email address and the name is optional
        const emailField = document.getElementById('senderEmailField');
        const emailInput = document.getElementById('senderEmail');
        const nameInput = document.getElementById('senderName');
        if (wii) {
          if (emailField) emailField.style.display = 'none';
          if (emailInput) emailInput.required = false;
          if (nameInput) nameInput.required = false;
        }
      }
      document.querySelectorAll('input[name="wiiAttach"], input[name="cardType"]').forEach((r) => {
        r.addEventListener('change', applyWiiMode);
      });

      // Tab switcher
      function switchTab(tab) {
        const emailPanel = document.getElementById('panelEmail');
        const discordPanel = document.getElementById('panelDiscord');
        const tabEmail = document.getElementById('tabEmail');
        const tabDiscord = document.getElementById('tabDiscord');
        const wiiPanel = document.getElementById('panelWii');
        const tabWii = document.getElementById('tabWii');
        const senderNameField = document.getElementById('senderNameField');
        const senderEmailField = document.getElementById('senderEmailField');
        const senderNameInput = document.getElementById('senderName');
        const senderEmailInput = document.getElementById('senderEmail');
        const deliveryMethod = document.getElementById('deliveryMethod');

        const senderFieldsGroup = document.getElementById('senderFields');

        for (const [method, panel] of [['email', emailPanel], ['discord', discordPanel], ['wii', wiiPanel]]) {
          if (panel) panel.querySelectorAll('input, select, textarea, button').forEach((field) => {
            field.disabled = method !== tab || field.dataset.wiiEnabled === '0';
          });
        }
        if (senderNameInput) senderNameInput.disabled = tab === 'discord';
        if (senderEmailInput) senderEmailInput.disabled = tab !== 'email';

        if (wiiPanel) wiiPanel.style.display = tab === 'wii' ? '' : 'none';
        if (tabWii) tabWii.classList.toggle('tab-active', tab === 'wii');

        if (tab === 'email' || tab === 'wii') {
          emailPanel.style.display = tab === 'email' ? '' : 'none';
          discordPanel.style.display = 'none';
          tabEmail.classList.toggle('tab-active', tab === 'email');
          tabDiscord.classList.remove('tab-active');
          if (tab === 'wii') document.getElementById('recipientEmail').value = '';
          // Clear discord fields to prevent accidental submission
          document.getElementById('recipientDiscord').value = '';
          // Show name and email fields - both required for email
          if (senderFieldsGroup) senderFieldsGroup.style.display = '';
          if (senderNameField) senderNameField.style.display = '';
          if (senderEmailField) senderEmailField.style.display = '';
          if (senderNameInput) senderNameInput.required = true;
          if (senderEmailInput) senderEmailInput.required = true;
          if (deliveryMethod) deliveryMethod.value = tab;
        } else {
          emailPanel.style.display = 'none';
          discordPanel.style.display = '';
          tabEmail.classList.remove('tab-active');
          tabDiscord.classList.add('tab-active');
          // Clear email field
          document.getElementById('recipientEmail').value = '';
          // Hide entire "About you" section - not needed for Discord
          if (senderFieldsGroup) senderFieldsGroup.style.display = 'none';
          if (senderNameField) senderNameField.style.display = 'none';
          if (senderEmailField) senderEmailField.style.display = 'none';
          if (senderNameInput) senderNameInput.required = false;
          if (senderEmailInput) senderEmailInput.required = false;
          if (deliveryMethod) deliveryMethod.value = 'discord';
        }
        applyWiiMode();
      }
      document.querySelectorAll('[data-tab]').forEach((b) => b.addEventListener('click', () => switchTab(b.dataset.tab)));
      switchTab(document.getElementById('deliveryMethod').value);

      // Discord tab click - redirect to login if not authorized, otherwise switch tabs
      (function () {
        const tabDiscord = document.getElementById('tabDiscord');
        if (!tabDiscord) return;
        tabDiscord.addEventListener('click', function () {
          if (tabDiscord.dataset.discordAuth === '0') {
            window.location.href = '/discord';
          } else {
            switchTab('discord');
          }
        });
      })();

    </script>
    <dialog id="doodleDialog" class="doodle-dialog" aria-labelledby="doodleHeading">
      <h2 id="doodleHeading" class="panel-title">Draw a doodle</h2>
      <div class="doodle-toolbar">
        <div id="doodleColors" class="doodle-group" role="group" aria-label="Colours"></div>
        <div id="doodleSizes" class="doodle-group" role="group" aria-label="Brush size"></div>
        <div class="doodle-group">
          <button type="button" class="btn btn-secondary is-active" data-tool="draw">Draw</button>
          <button type="button" class="btn btn-secondary" data-tool="fill">Fill</button>
          <button type="button" class="btn btn-secondary" data-tool="eraser">Erase</button>
          <button type="button" class="btn btn-secondary" id="doodleUndo">Undo</button>
          <button type="button" class="btn btn-secondary" id="doodleClear">Clear</button>
        </div>
      </div>
      <canvas id="doodleCanvas" width="600" height="350" aria-label="Doodle canvas"></canvas>
      <div class="doodle-actions">
        <button type="button" class="btn btn-secondary" id="doodleCancel">Cancel</button>
        <button type="button" class="btn btn-primary" id="doodleUse">Use doodle</button>
      </div>
    </dialog>
    <script src="/js/wii-preview.js" defer></script>
    <script src="/js/mii-input.js" defer></script>
    <script src="/js/wii-mii-face.js" defer></script>
    <script src="/js/editor.js" defer></script>
    <script src="/js/doodle.js" defer></script>
  </body>
</html>
